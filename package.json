{
  "name": "shipcli-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "pnpm build:packages && pnpm build:web",
    "build:packages": "tsc -b tsconfig.packages.json",
    "build:web": "pnpm --filter shipcli-web build",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "changeset": "changeset",
    "dev:web": "pnpm --filter shipcli-web dev",
    "lint": "eslint .",
    "release": "pnpm check && pnpm test:package && changeset publish",
    "test": "pnpm build:packages && node --import tsx --test test/*.test.ts",
    "test:package": "pnpm build:packages && node --import tsx scripts/package-smoke.ts",
    "verify:release": "node --import tsx scripts/verify-release.ts",
    "typecheck": "pnpm build:packages && tsc -p tsconfig.test.json --noEmit && pnpm --filter shipcli-example-hello typecheck && pnpm --filter shipcli-web exec tsc --noEmit"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "globals": "^17.12.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
