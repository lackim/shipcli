{
  "name": "@shipcli/core",
  "version": "0.5.1",
  "description": "CLI framework: output, config, commands",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./output": {
      "types": "./dist/output.d.ts",
      "import": "./dist/output.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./spinner": {
      "types": "./dist/spinner.d.ts",
      "import": "./dist/spinner.js"
    },
    "./update-check": {
      "types": "./dist/update-check.d.ts",
      "import": "./dist/update-check.js"
    },
    "./project-config": {
      "types": "./dist/project-config.d.ts",
      "import": "./dist/project-config.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "prepack": "pnpm run build"
  },
  "keywords": [
    "cli",
    "framework",
    "shipcli"
  ],
  "license": "MIT",
  "homepage": "https://github.com/lackim/shipcli#readme",
  "bugs": {
    "url": "https://github.com/lackim/shipcli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lackim/shipcli.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "kleur": "^4.1.5",
    "nanospinner": "^1.2.2"
  }
}
