{
  "name": "@shipcli/cli",
  "version": "0.2.0",
  "description": "CLI-as-a-Product toolkit — build, publish, and promote CLI tools",
  "type": "module",
  "bin": {
    "shipcli": "./dist/cli.js"
  },
  "files": ["dist", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "prepack": "pnpm run build"
  },
  "keywords": ["cli", "toolkit", "shipcli"],
  "license": "MIT",
  "homepage": "https://github.com/lackim/shipcli#readme",
  "bugs": {
    "url": "https://github.com/lackim/shipcli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lackim/shipcli.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@shipcli/core": "workspace:^",
    "@shipcli/build": "workspace:^",
    "@shipcli/share": "workspace:^",
    "@shipcli/landing": "workspace:^"
  }
}
