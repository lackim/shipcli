{
  "name": "@shipcli/landing",
  "version": "0.5.1",
  "description": "Next.js landing page template with terminal demo",
  "type": "module",
  "main": "./dist/scaffold.js",
  "types": "./dist/scaffold.d.ts",
  "exports": {
    ".": {
      "types": "./dist/scaffold.d.ts",
      "import": "./dist/scaffold.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "prepack": "pnpm run build"
  },
  "keywords": [
    "cli",
    "landing-page",
    "nextjs",
    "shipcli"
  ],
  "license": "MIT",
  "homepage": "https://github.com/lackim/shipcli#readme",
  "bugs": {
    "url": "https://github.com/lackim/shipcli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lackim/shipcli.git",
    "directory": "packages/landing"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@shipcli/core": "workspace:^"
  }
}
